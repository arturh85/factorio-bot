{
  "name": "factorio-bot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "yarn run tauri:serve",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit --skipLibCheck && vue-tsc --noEmit --skipLibCheck && eslint src/",
    "lint1": "vue-tsc --noEmit --skipLibCheck",
    "serve": "vite --port 8080",
    "native:serve": "cross-env VITE_HTTP_HANDLER=NATIVE vite --port 8080",
    "native:start": "tauri dev",
    "build:web": "vite build",
    "tauri:keygen": "tauri signer generate -w ../../factorio-bot.key",
    "tauri:serve": "concurrently -r -n \"rust,VITE\" -k \"yarn tauri dev\" \"yarn run native:serve\"",
    "tauri:serve:release": "concurrently -r -n \"rust,VITE\" -k \"yarn tauri dev --release\" \"yarn run native:serve\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "cross-env VITE_HTTP_HANDLER=NATIVE vite build && tauri build",
    "test:ci": "yarn run lint && yarn run test:coverage && yarn run tauri:build && yarn run cargo:test && yarn run cargo:clippy",
    "cargo:clippy": "cd .. && cargo clippy --workspace --all-features --all-targets -- --deny warnings --deny deprecated",
    "cargo:test": "cd .. && cargo test",
    "cargo:tree": "cd .. && cargo tree --charset ascii > tree.txt",
    "cargo:docs": "cd .. && cargo doc --all --no-deps",
    "cargo:userguide": "cd ../docs/userguide && mdbook serve -o",
    "cargo:devguide": "cd ../docs/devguide && mdbook serve -o",
    "changelog:update": "cd .. && git cliff --output CHANGELOG.md --config Cargo.toml",
    "precommit:check": "yarn run lint && yarn run test:coverage && yarn run cargo:clippy && yarn run cargo:test && cd .. && cargo build --all-features && cargo build --no-default-features",
    "dummy": "true"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@vue/devtools-api": "^8",
    "@vueuse/core": "14.4.0",
    "ansi-html": "0.0.9",
    "monaco-editor": "0.55.1",
    "pinia": "^4",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "3.53.1",
    "vue": "3.5.42",
    "vue-router": "^5",
    "ynetwork": "3.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/compiler-sfc": "3.5.42",
    "concurrently": "^10",
    "cross-env": "10.1.0",
    "eslint": "^10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "^10",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "^7",
    "sass": "1.103.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "^6",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10",
    "vue-tsc": "3.3.11"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "license": "MIT"
}
